{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Desktop Buddy",
  "version": "0.4.0",
  "identifier": "local.dharu.desktopbuddy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Desktop Buddy",
        "create": false,
        "width": 960,
        "height": 720,
        "minWidth": 380,
        "minHeight": 540,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "shortDescription": "Local tasks, focus and project tools",
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}

